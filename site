<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PONSWORLD｜ちょこっと不思議な冒険サーバー</title>
<meta name="description" content="PONSWORLD｜ちょこっと不思議な冒険サーバー。Java版 26.2 対応の Minecraft サーバーです。">
<meta property="og:type" content="website">
<meta property="og:title" content="PONSWORLD｜ちょこっと不思議な冒険サーバー">
<meta property="og:description" content="Java版 26.2 対応の Minecraft サーバー。初心者歓迎、Discord から参加できます。">
<link rel="icon" type="image/png" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DotGothic16&family=Zen+Maru+Gothic:wght@500;700;900&display=swap">
<style>
/* Layout: 草原ブロックの地層を下へ掘り進む一本道。各セクションは地層のひとつ。 */
:root {
  --sky: #f5f7f6;
  --paper: #ffffff;
  --ink: #1c2522;
  --ink-soft: #5c6863;
  --line: #e2e7e5;
  --emerald: #15975f;
  --emerald-deep: #0f7a4c;
  --emerald-tint: #e9f5ef;
  --pumpkin: #15975f;
  --pumpkin-tint: #ffffff;
  --dirt: #e2e7e5;
  --logo-filter: none;
  --font-display: "DotGothic16", "Hiragino Kaku Gothic ProN", "Yu Gothic", monospace;
  --font-body: "Zen Maru Gothic", "Hiragino Maru Gothic ProN", "Yu Gothic", sans-serif;
  --r: 6px;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --sky: #121615; --paper: #181d1c; --ink: #e8eeeb; --ink-soft: #9aa6a1; --line: #2a3230;
    --emerald: #3ccf8e; --emerald-deep: #7fe0b4; --emerald-tint: #1a2c25;
    --pumpkin: #3ccf8e; --pumpkin-tint: #181d1c; --dirt: #2a3230;
    --logo-filter: invert(1);
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --sky: #121615; --paper: #181d1c; --ink: #e8eeeb; --ink-soft: #9aa6a1; --line: #2a3230;
  --emerald: #3ccf8e; --emerald-deep: #7fe0b4; --emerald-tint: #1a2c25;
  --pumpkin: #3ccf8e; --pumpkin-tint: #181d1c; --dirt: #2a3230;
  --logo-filter: invert(1);
  color-scheme: dark;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } * { animation: none !important; transition: none !important; } }
body {
  background: var(--sky);
  color: var(--ink);
  font-family: var(--font-body);
  font-weight: 500;
  font-size: 16px;
  line-height: 1.85;
  padding-inline: 16px;
}
a { color: var(--emerald-deep); }
a:focus-visible, button:focus-visible { outline: 3px solid var(--pumpkin); outline-offset: 3px; }
h1, h2, h3 { text-wrap: balance; line-height: 1.35; margin: 0; }
p { margin: 0; }
.wrap { max-width: 1040px; margin-inline: auto; }

/* ナビ */
.nav {
  position: sticky; top: env(safe-area-inset-top, 0px); z-index: 10;
  margin-inline: -16px; padding: 10px 16px;
  background: color-mix(in srgb, var(--sky) 88%, transparent);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--line);
}
.nav .wrap { display: flex; align-items: center; gap: 16px; }
.logo { font-family: var(--font-display); font-size: 20px; color: var(--ink); text-decoration: none; display: flex; align-items: center; gap: 8px; letter-spacing: .04em; }
.nav-links { display: flex; gap: 18px; margin-left: auto; font-size: 14px; font-weight: 700; flex-wrap: wrap; }
.nav-links a { color: var(--ink-soft); text-decoration: none; }
.nav-links a:hover { color: var(--emerald-deep); }
@media (max-width: 720px) { .nav-links { display: none; } }

.btn {
  display: inline-flex; align-items: center; gap: 10px;
  font-family: var(--font-body); font-weight: 900; font-size: 16px;
  padding: 12px 22px; border-radius: var(--r);
  background: var(--emerald); color: #fff; text-decoration: none;
  box-shadow: 0 4px 0 var(--emerald-deep);
  transition: transform .12s, box-shadow .12s;
}
:root[data-theme="dark"] .btn { color: #0b1d16; }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .btn { color: #0b1d16; } }
.btn:hover { transform: translateY(2px); box-shadow: 0 2px 0 var(--emerald-deep); }
.btn.small { padding: 7px 14px; font-size: 14px; box-shadow: 0 3px 0 var(--emerald-deep); }

/* ヒーロー */
.hero { padding-block: 56px 0; display: grid; grid-template-columns: 1.15fr .85fr; gap: 32px; align-items: center; }
.hero > * { min-width: 0; }
@media (max-width: 760px) { .hero { grid-template-columns: 1fr; padding-block: 36px 0; } }
.eyebrow { font-family: var(--font-display); font-size: 14px; color: var(--emerald-deep); letter-spacing: .12em; }
.hero h1 { font-family: var(--font-display); font-weight: 400; font-size: clamp(44px, 9vw, 84px); letter-spacing: .04em; line-height: 1.1; margin-block: 8px 12px; }
.hero h1 span { color: var(--emerald); }
.catch { font-size: clamp(20px, 3.2vw, 26px); font-weight: 900; }
.lead { color: var(--ink-soft); margin-block: 14px 26px; max-width: 30em; }
.hero-actions { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; }
.spec { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 22px; }
.chip { font-size: 13px; font-weight: 700; padding: 3px 12px; border-radius: 999px; background: var(--paper); border: 1px solid var(--line); color: var(--ink-soft); }
.chip b { color: var(--ink); }

.hero-logo { width: min(300px, 70%); max-width: 100%; justify-self: center; filter: var(--logo-filter); }
@media (max-width: 760px) { .hero-logo { width: 160px; justify-self: start; order: -1; } }
.nav-logo { width: 24px; height: auto; filter: var(--logo-filter); }

.shot { margin: 0; min-width: 0; }
.shot img { display: block; width: 100%; max-width: 100%; border-radius: var(--r); border: 1px solid var(--line); }
.shot figcaption { font-size: 13px; color: var(--ink-soft); margin-top: 8px; }
.hero-shot { margin-top: 40px; }
.hero-shot img { aspect-ratio: 1600 / 656; object-fit: cover; }
.card-img { display: block; width: 100%; max-width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 4px; }
.plaza { margin-top: 28px; }

/* 地層 */
.ground { height: 1px; margin-top: 48px; margin-inline: -16px; background: var(--line); }
.stratum { background: var(--paper); margin-inline: -16px; padding: 64px 16px; border-bottom: 1px solid var(--line); }
.stratum.alt { background: var(--sky); }

.sec-head { margin-bottom: 32px; max-width: 40em; }
.sec-head .eyebrow { display: block; margin-bottom: 4px; }
.sec-head h2 { font-size: clamp(26px, 4vw, 34px); font-weight: 900; }
.sec-head p { color: var(--ink-soft); margin-top: 8px; }

/* 遊びカード */
.cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 18px; }
.card { background: var(--sky); border: 1px solid var(--line); border-radius: var(--r); padding: 22px; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
.stratum.alt .card { background: var(--paper); }
.card-top { display: flex; align-items: center; gap: 12px; }
.icon { width: 40px; height: 40px; flex: none; image-rendering: pixelated; }
.card h3 { font-size: 19px; font-weight: 900; }
.card ul { margin: 0; padding-left: 1.1em; color: var(--ink-soft); font-size: 15px; }
.card li + li { margin-top: 4px; }
.card li::marker { color: var(--emerald); }
.tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; padding-top: 6px; }
.tag { font-size: 12px; font-weight: 700; padding: 2px 10px; border-radius: 4px; background: var(--paper); border: 1px solid var(--line); color: var(--ink-soft); }
.note { font-size: 13px; color: var(--ink-soft); border-top: 1px dashed var(--line); padding-top: 8px; margin-top: auto; }

/* はじめかた */
.steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; counter-reset: s; }
@media (max-width: 760px) { .steps { grid-template-columns: 1fr; } }
.step { position: relative; padding: 22px 22px 22px 22px; background: var(--paper); border: 1px solid var(--line); border-radius: var(--r); min-width: 0; }
.step::before { counter-increment: s; content: "STEP " counter(s); font-family: var(--font-display); font-size: 13px; color: var(--emerald-deep); letter-spacing: .1em; }
.step h3 { font-size: 18px; font-weight: 900; margin-block: 4px 6px; }
.step p { color: var(--ink-soft); font-size: 15px; }

.cmds { margin-top: 32px; background: var(--paper); border: 1px solid var(--line); border-radius: var(--r); padding: 22px; }
.cmds h3 { font-size: 17px; font-weight: 900; margin-bottom: 12px; }
.cmd-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 10px 24px; margin: 0; }
.cmd-list div { display: flex; flex-direction: column; min-width: 0; }
.cmd-list dt { font-family: var(--font-display); font-size: 16px; color: var(--emerald-deep); }
.cmd-list dd { margin: 0; font-size: 14px; color: var(--ink-soft); }

/* イベント */
.events { display: grid; grid-template-columns: 1.4fr 1fr; gap: 18px; }
@media (max-width: 760px) { .events { grid-template-columns: 1fr; } }
.event { border-radius: var(--r); padding: 26px; min-width: 0; border: 1px solid var(--line); background: var(--sky); }
.event.now { background: var(--pumpkin-tint); border-color: color-mix(in srgb, var(--pumpkin) 45%, transparent); }
.status { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 900; padding: 2px 12px; border-radius: 999px; background: var(--emerald); color: var(--paper); }
.status.plan { background: var(--line); color: var(--ink-soft); }
.status .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--paper); animation: blink 1.4s infinite; }
@keyframes blink { 50% { opacity: .3; } }
.event h3 { font-size: 24px; font-weight: 900; margin-block: 10px 6px; }
.event .when { font-size: 14px; color: var(--ink-soft); margin-bottom: 14px; }
.event ul { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.event li { background: var(--paper); border-radius: 4px; padding: 8px 12px; font-weight: 700; font-size: 15px; }

/* ルール・FAQ */
.two { display: grid; grid-template-columns: 1fr 1.4fr; gap: 40px; }
@media (max-width: 820px) { .two { grid-template-columns: 1fr; } }
.two > * { min-width: 0; }
.prep { background: var(--sky); border: 2px dashed var(--line); border-radius: var(--r); padding: 22px; color: var(--ink-soft); }
.prep strong { color: var(--ink); display: block; margin-bottom: 4px; }
.faq details { border-bottom: 1px solid var(--line); }
.faq summary { cursor: pointer; padding: 14px 4px; font-weight: 900; list-style: none; display: flex; gap: 12px; align-items: baseline; }
.faq summary::-webkit-details-marker { display: none; }
.faq summary::before { content: "Q"; font-family: var(--font-display); color: var(--emerald); flex: none; }
.faq summary::after { content: "+"; margin-left: auto; font-family: var(--font-display); color: var(--ink-soft); }
.faq details[open] summary::after { content: "−"; }
.faq details p { padding: 0 4px 16px 28px; color: var(--ink-soft); font-size: 15px; }

/* フッターCTA */
.join { text-align: center; padding-block: 72px; }
.join h2 { font-family: var(--font-display); font-weight: 400; font-size: clamp(28px, 5vw, 42px); }
.join p { color: var(--ink-soft); margin-block: 10px 26px; }
.join .url { display: block; margin-top: 14px; font-size: 13px; color: var(--ink-soft); word-break: break-all; }
footer { margin-inline: -16px; padding: 22px 16px; border-top: 1px solid var(--line); font-size: 13px; color: var(--ink-soft); }
footer .wrap { display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between; }
</style>
</head>
<body>

<header class="nav">
  <div class="wrap">
    <a class="logo" href="#top"><img class="nav-logo" src="data:image/png;base64," alt="">PONSWORLD</a>
    <nav class="nav-links" aria-label="ページ内リンク">
      <a href="#features">あそび</a>
