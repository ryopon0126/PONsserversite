<script>
// 画像がまだない枠は、差し替え用の枠として表示する
document.querySelectorAll('.shot img').forEach(function(img){
  function miss(){ img.closest('.shot').classList.add('missing'); }
  if(img.complete && img.naturalWidth===0){ miss(); }
  img.addEventListener('error', miss);
});

// スマホの目次の開け閉め
var log=document.getElementById('log');
var tg=document.getElementById('logtoggle');
tg.addEventListener('click',function(){
  var open=log.classList.toggle('open');
  tg.setAttribute('aria-expanded',open?'true':'false');
});
document.querySelectorAll('#loglist a').forEach(function(a){
  a.addEventListener('click',function(){
    log.classList.remove('open');
    tg.setAttribute('aria-expanded','false');
  });
});

// 今読んでいる章を、目次で光らせる
var links={};
document.querySelectorAll('#loglist a').forEach(function(a){ links[a.getAttribute('href').slice(1)]=a; });
if('IntersectionObserver' in window){
  var io=new IntersectionObserver(function(es){
    es.forEach(function(e){
      if(e.isIntersecting){
        Object.values(links).forEach(function(l){ l.classList.remove('on'); });
        var l=links[e.target.id]; if(l){ l.classList.add('on'); }
      }
    });
  },{rootMargin:'-30% 0px -60% 0px'});
  document.querySelectorAll('.chapter').forEach(function(s){ io.observe(s); });
}
</script>
