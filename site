<script>
(function () {
  // ピクセルアイコン（8x8）
  const P = {
    g: "#17a56b", G: "#0d7a4e", l: "#7ff0b8", w: "#ffffff", k: "#2b2b2b",
    b: "#8a5a3c", B: "#5e3b26", y: "#f5c542", Y: "#d99a1a", r: "#e0533d",
    o: "#e8771e", p: "#c9a6ff", s: "#b9c4c9", S: "#7c8a90", c: "#f2e3c2", C: "#d2b98a", t: "#fff2a8"
  };
  const ICONS = {
    emerald: ["...gg...", "..glgg..", ".glggGg.", "glgggGGg", "gggggGGg", ".gggGGg.", "..gGGg..", "...gg..."],
    book:    [".bbbbbb.", "bccccccb", "bcrrrrcb", "bccccccb", "bcrrrccb", "bccccccb", "bBBBBBBb", ".bbbbbb."],
    star:    ["...yy...", "...yy...", "yyyyyyyy", ".yyYyyy.", "..yyyy..", ".yyYYyy.", ".yy..yy.", "y......y"],
    box:     ["pppppppp", "pyyyyyyp", "pppyyppp", "p.pyyp.p", "p.pyyp.p", "p.pyyp.p", "p.pyyp.p", "pppppppp"],
    sword:   [".......s", "......ss", ".....ss.", "y...ss..", ".y.ss...", "..bs....", ".bBy....", "bb..y..."],
    mascot:  ["..gggg..", ".gggggg.", "gwkggwkg", "gwkggwkg", "gggggggg", "gggrrggg", ".gggggg.", ".g.gg.g."],
    paw:     [".o....o.", "ooo..ooo", ".o....o.", "...oo...", "..oooo..", ".oooooo.", ".oooooo.", "..o..o.."],
    scroll:  ["CccccccC", "Cc....cC", ".cBBBBc.", ".c....c.", ".cBBB.c.", ".c....c.", "CccccccC", "CCCCCCCC"]
  };
  const css = getComputedStyle(document.documentElement);
  const ACC = css.getPropertyValue("--emerald").trim() || "#15975f";
  const BG = css.getPropertyValue("--paper").trim() || "#ffffff";
  function draw(cv, rows, scale) {
    const x = cv.getContext("2d");
    rows.forEach((row, j) => [...row].forEach((ch, i) => {
      if (P[ch]) { x.fillStyle = ch === "w" ? BG : ACC; x.fillRect(i * scale, j * scale, scale, scale); }
    }));
  }
  document.querySelectorAll("canvas[data-icon]").forEach(cv => {
    const rows = ICONS[cv.dataset.icon]; if (rows) draw(cv, rows, 1);
  });

})();
</script>

